                  },
                  {
                      "name":  "Job run history",
                      "method":  "GET",
                      "path":  "/api/v1/admin/jobs/runs",
                      "role":  "admin"
                  },
                  {
                      "name":  "Account",
                      "method":  "GET",
                      "path":  "/api/v1/account",
                      "role":  "investor"
                  }
