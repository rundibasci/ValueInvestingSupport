{
    "mode":  "dry-run",
    "baseUrl":  "http://localhost:8080",
    "symbols":  [
                    "AAPL",
                    "KO",
                    "JNJ",
                    "PG",
                    "MSFT"
                ],
    "steps":  [
                  {
                      "name":  "Admin login",
                      "method":  "POST",
