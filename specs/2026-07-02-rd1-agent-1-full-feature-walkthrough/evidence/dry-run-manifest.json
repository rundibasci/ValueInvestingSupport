                      "role":  "admin"
                  },
                  {
                      "name":  "Investor login",
                      "method":  "POST",
                      "path":  "/auth/login",
                      "role":  "investor"
                  },
                  {
                      "name":  "Backend health",
                      "method":  "GET",
                      "path":  "/actuator/health",
                      "role":  "public"
                  },
                  {
                      "name":  "Dashboard summary",
                      "method":  "GET",
                      "path":  "/api/v1/dashboard",
                      "role":  "investor"
                  },
                  {
                      "name":  "Screener conservative evidence",
                      "method":  "POST",
                      "path":  "/api/v1/screener",
                      "role":  "investor"
                  },
                  {
                      "name":  "AAPL security detail",
                      "method":  "GET",
                      "path":  "/api/v1/securities/AAPL",
                      "role":  "investor"
                  },
                  {
                      "name":  "KO review packet",
                      "method":  "GET",
                      "path":  "/api/v1/securities/KO/review",
                      "role":  "investor"
                  },
                  {
                      "name":  "Watchlist",
                      "method":  "GET",
                      "path":  "/api/v1/watchlist",
                      "role":  "investor"
                  },
                  {
                      "name":  "Portfolio list",
                      "method":  "GET",
                      "path":  "/api/v1/portfolios",
                      "role":  "investor"
                  },
                  {
                      "name":  "Job definitions",
                      "method":  "GET",
                      "path":  "/api/v1/admin/jobs",
