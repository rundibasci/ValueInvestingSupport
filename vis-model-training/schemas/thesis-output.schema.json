{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valueinvestingsupport.local/schemas/thesis-output.schema.json",
  "title": "VIS Investment Thesis Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "confidence",
    "summary",
    "bullCase",
    "bearCase",
    "keyRisks",
    "keyAssumptions",
    "invalidationConditions",
    "dataWarnings",
    "humanReviewRequired"
  ],
  "properties": {
    "classification": {
      "enum": [
        "POTENTIALLY_UNDERVALUED",
        "FAIRLY_VALUED",
        "POTENTIALLY_OVERVALUED",
        "UNDER_REVIEW",
        "INSUFFICIENT_DATA"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "bullCase": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "bearCase": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "keyRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keyAssumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidationConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataWarnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "humanReviewRequired": {
      "type": "boolean"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "evidenceFields"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidenceFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "marketPrice",
              "intrinsicValue",
              "marginOfSafetyPercent",
              "valueScore",
              "dividendYieldPercent",
              "payoutRatioPercent",
              "netDebtToEbitda",
              "revenueTrend",
              "earningsTrend",
              "freeCashFlowTrend",
              "dataQuality",
              "deterministicWarnings"
            ]
          }
        }
      }
    }
  }
}
