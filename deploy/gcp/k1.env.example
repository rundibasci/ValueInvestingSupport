# Copy to deploy/gcp/k1.env (gitignored), fill non-secret values, then export:
# K1_CONFIG_FILE=deploy/gcp/k1.env

K1_GCP_PROJECT_ID=replace-me
K1_GCP_REGION=europe-west1
K1_RESOURCE_PREFIX=vis-k1
K1_ARTIFACT_REPOSITORY=vis-k1
K1_CLOUD_RUN_SERVICE=vis-k1-api
K1_RUNTIME_SERVICE_ACCOUNT=vis-k1-runtime
K1_CLOUD_SQL_INSTANCE=vis-k1-postgres
K1_DATABASE_NAME=vis
K1_REDIS_INSTANCE=vis-k1-redis
K1_VPC_NETWORK=vis-k1
K1_VPC_SUBNET=vis-k1-europe-west1
K1_VPC_SUBNET_RANGE=10.20.0.0/24

# Immutable image tag, normally the full Git commit SHA.
K1_IMAGE_TAG=replace-with-git-sha

# Conservative K1 sizing. Review current GCP pricing before provisioning.
K1_CLOUD_SQL_TIER=db-f1-micro
K1_CLOUD_SQL_DISK_GB=10
K1_REDIS_SIZE_GB=1
K1_CLOUD_RUN_MEMORY=1Gi
K1_CLOUD_RUN_CPU=1
K1_CLOUD_RUN_MIN_INSTANCES=0
K1_CLOUD_RUN_MAX_INSTANCES=1

# Cloud Monitoring destination. An existing channel takes precedence; otherwise the monitoring
# script creates/reuses an email channel through the gcloud beta monitoring surface.
K1_NOTIFICATION_CHANNEL=
K1_ALERT_EMAIL=

# K1 stakeholder access: "public" allows unauthenticated Cloud Run invocation while
# Spring Security still protects business APIs; "authenticated" requires Cloud Run IAM.
K1_INVOKER_MODE=authenticated

# Secret Manager container names. Values are created interactively/outside repository scripts.
K1_SECRET_FMP_API_KEY=vis-k1-fmp-api-key
K1_SECRET_DATABASE_USERNAME=vis-k1-database-username
K1_SECRET_DATABASE_PASSWORD=vis-k1-database-password
K1_SECRET_JWT_PRIVATE_KEY=vis-k1-jwt-private-key
K1_SECRET_JWT_PUBLIC_KEY=vis-k1-jwt-public-key

# Optional email delivery secrets. Leave email disabled until all values exist.
K1_ALERT_EMAIL_ENABLED=false
K1_ALERT_EMAIL_FROM=
K1_SPRING_MAIL_HOST=
K1_SPRING_MAIL_PORT=587
K1_SECRET_SMTP_USERNAME=vis-k1-smtp-username
K1_SECRET_SMTP_PASSWORD=vis-k1-smtp-password
