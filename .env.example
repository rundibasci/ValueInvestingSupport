# Active Spring profile: demo | local | prod
SPRING_PROFILES_ACTIVE=local

# Deployment guard. K1 must remain at exactly one Cloud Run instance while scheduled jobs run in-process.
APP_DEPLOYMENT_MODE=local
APP_DECLARED_MAX_INSTANCES=1
PORT=8080

# Data source selection (FMP is the persisted default for all ingestion/services)
MARKET_DATA_SOURCE=fmp

# FMP API key required for provider-backed ingestion/services
FMP_API_KEY=

# Database (not needed for demo profile)
DATABASE_URL=jdbc:postgresql://localhost:5432/vis
DATABASE_USERNAME=vis
DATABASE_PASSWORD=vis

# Redis (not needed for demo profile)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (not needed for demo profile — added in Phase A3)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# On-demand seed endpoint default ticker list (Val2)
SEED_TICKERS=AAPL,MSFT,KO,JNJ

# Alert email (G2): Spring Mail SMTP settings. Keep disabled unless SMTP is configured.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_MAX_ATTEMPTS=3
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Google OAuth2 (J1): OpenID Connect sign-in. Leave blank to disable Google login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_FRONTEND_CALLBACK=http://localhost:5173/auth/oauth2/callback

# AI Investment Thesis (Vertex AI / Gemini — Group TA, Phase TA4). Stays disabled until the
# TA4 acceptance suite (including the v3 prompt corpus re-run) has passed.
# Local/dev credentials: Application Default Credentials (`gcloud auth application-default
# login`) — no service-account key file for local dev, this session's explicit decision.
THESIS_AGENT_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=
GEMINI_MODEL_ID=
GOOGLE_APPLICATION_CREDENTIALS=
THESIS_GENERATION_DAILY_LIMIT=5
THESIS_GENERATION_MAX_RETRIES=1
